<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <title>Sign up</title>
    <style>
        body { background: url('/domi.png') center/cover fixed no-repeat; min-height: 100vh; }
        .box { max-width: 400px; background: rgba(255,255,255,0.6); backdrop-filter: blur(4px);
               padding: 25px; border-radius: 12px; margin: 80px auto; }
    </style>
</head>
<body>
    <div class="box">
        <h2>Sign up</h2>
        <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
        <form action="/register" method="POST">
            <input class="form-control mb-3" name="username" placeholder="Username" required>
            <input class="form-control mb-3" type="password" name="password" placeholder="Password (6+ characters)" required>
            <button class="btn btn-success w-100" type="submit">Sign up</button>
        </form>
        <p class="mt-3 mb-0">Already have an account? <a href="/login">Log in</a></p>
    </div>
</body>
</html>