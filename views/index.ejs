<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
     content="width=device-width, initial-scale=1.0">
     <meta http-equiv="X-UA-Compatible" content="ie=edge">
     <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
 <style>body {
        background-image: url('/domi.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
        min-height: 100vh;
    }

    .container {
        background: rgba(255, 255, 255, 0.4);
        backdrop-filter: blur(4px);
        padding: 25px;
        border-radius: 12px;
        margin-top: 30px;
        margin-bottom: 30px;
    }

    .table{
        --bs-table-bg: transparent;
        --bs-table-striped-bg: rgba(255, 255, 255, 0.7);
        --bs-table-hover-bg: rgba(255, 255, 255, 0.7);
        color: #fff;
    }
    .table > :not(caption) > * > * {
        background-color: transparent;
        box-shadow: inset 0 0 0 9999px transparent;
    } 
    .table-striped > tbody > tr:nth-of-type(odd) {
        background-color: rgba(255, 255, 255, 0.7);
    }
    .table-hover > tbody > tr:hover> * {
        background-color: rgba(255, 255, 255, 0.7);
    }
    .table {color: #9fd3ff;}
    .container h1 {color: #fff;}
</style>
     
    <title>Document</title>

    
</head>
<body>

    

    <div class="container">
        <form action="/logout" method="POST" class="text-end">
    <button class="btn btn-outline-dark btn-sm" type="submit">Log out</button>
</form>
        <h1>URL Shortener</h1>
            <form action="/shortUrls" method="POST" class="my-4">
    <label for="fullUrl" class="visually-hidden">
        URL to shorten
    </label>

    <div class="input-group">
        <input
            required
            placeholder="Enter a valid URL to shorten"
            type="url"
            name="fullUrl"
            id="fullUrl"
            class="form-control"
        >

        <button class="btn btn-success" type="submit">
            Shorten
        </button>
    </div>
    </form>
    
      <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Full URL</th>
                    <th>Short URL</th>
                    <th>Clicks</th>
                </tr>
            </thead>

        <tbody>
            <% shortUrls.forEach(shortUrl => { %>
                <tr>
                    <td>
                        <a href="<%= shortUrl.full %>"
                           target="_blank"
                           rel="noopener noreferrer">

                            <%= shortUrl.full %>
                        </a>
                    </td>

                    <td>
                        <a href="<%= shortUrl.short %>">
                            <%= shortUrl.short %>
                        </a>
                    </td>

                    <td> 
                        <%= shortUrl.clicks %>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
    </div>
</div>
</body>
</html>